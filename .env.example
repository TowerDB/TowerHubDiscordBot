# Copy to .env and fill in real values. Never commit .env.

# Bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=PLACEHOLDER_BOT_TOKEN

# For local testing. Right-click your server -> Copy Server ID (Developer Mode must be on).
# Set this and commands register to that one server on startup, appearing instantly.
# Leave it unset in production to register globally, which can take up to an hour to show up.
GUILD_ID=YOUR_GUILD_ID

# Sliding-window rate limits, counted over the last 60 seconds. Commands and button clicks are
# counted separately, each from one server and from one person.
# Reaching MAX_REQUESTS_PER_SERVER_PER_MINUTE posts a "Slow down" notice in the channel, at most
# once a minute per server; reaching any other limit shows the same notice to that person only.
# Non-numeric or non-positive values fall back to the defaults (50, 10, 75, 10).
MAX_REQUESTS_PER_SERVER_PER_MINUTE=50
MAX_REQUESTS_PER_USER_PER_MINUTE=10
MAX_BUTTON_CLICKS_PER_SERVER_PER_MINUTE=75
MAX_BUTTON_CLICKS_PER_USER_PER_MINUTE=10

# Autocomplete suggestions are a TowerHub call per keystroke. Past this one person gets none.
MAX_SUGGESTIONS_PER_USER_PER_MINUTE=60

# Where Discord fetches item icons and eternal portraits from; images/items/<slug>.png and
# images/eternals/<slug>.png are appended to it. Defaults to the main branch on GitHub. Point it at
# another branch to show images that haven't been merged yet.
# IMAGE_BASE_URL=https://raw.githubusercontent.com/TowerDB/TowerHubDiscordBot/main/

# The TowerHub site, for its API and the links on embeds. Eternals, items and the glossary are read
# from its API. Defaults to the live site. Point it at a local one to test against it.
# TOWERHUB_URL=https://towerhub.io

# Secret. Must equal RateLimit__Reads__BotKey on TowerHub, which then leaves the bot's reads out of its
# per-address limits. Every server's traffic comes from one address, so without it the bot is throttled.
TOWERHUB_BOT_KEY=PLACEHOLDER_BOT_KEY
